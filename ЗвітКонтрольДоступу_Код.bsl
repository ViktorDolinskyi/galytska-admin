// ═══════════════════════════════════════════════════════════════════
// ЗОВНІШНІЙ ЗВІТ: Записи контролю доступу
// БАС Малий Бізнес / 1С:Підприємство 8.3
//
// Структура:
//   Форма «ФормаЗвіту» (керована)
//     Реквізити форми:
//       ФізичнаОсоба   — ТипЗначення: ПланВидівХарактеристик.ФізичніОсоби
//                        (або ДовідникПосилання.ФізичніОсоби — залежно від конфігурації)
//       ДатаПочатку    — Дата (ДатаЧас)
//       ДатаОкончания  — Дата (ДатаЧас)
//     Команди:
//       СформуватиЗвіт
//     Елементи:
//       ФізичнаОсоба   — поле вводу
//       ДатаПочатку    — поле дати
//       ДатаОкончания  — поле дати
//       КнопкаСформувати — кнопка → команда СформуватиЗвіт
//       ПолеТабДокумента — поле табличного документа (ім'я «Результат»)
// ═══════════════════════════════════════════════════════════════════


// ─── МОДУЛЬ ФОРМИ ───────────────────────────────────────────────────────────

&НаСервері
Процедура ПриСозданияНаСервере(Отказ, СтандартнаяОбработка)
	// Значення за замовчуванням: поточний місяць
	ДатаПочатку  = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = КонецМесяца(ТекущаяДата());
КонецПроцедуры

&НаКлиенте
Процедура СформуватиЗвіт(Команда)
	СформуватиЗвітНаСервері();
КонецПроцедуры

&НаСервері
Процедура СформуватиЗвітНаСервері()

	// ── перевірка параметрів ──────────────────────────────────────
	Если НЕ ЗначениеЗаполнено(ФізичнаОсоба) Тогда
		Сообщить("Вкажіть фізичну особу!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаПочатку) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Вкажіть період!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	// ── запит ────────────────────────────────────────────────────
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаписиКонтроляДоступа.ФизическоеЛицо          КАК ФизическоеЛицо,
	|	ЗаписиКонтроляДоступа.ТипДействия              КАК ТипДействия,
	|	ЗаписиКонтроляДоступа.НомерЗаписи              КАК НомерЗаписи,
	|	ЗаписиКонтроляДоступа.КонтрольДоступа          КАК КонтрольДоступа,
	|	ЗаписиКонтроляДоступа.ДатаЗаписи               КАК ДатаЗаписи
	|ИЗ
	|	РегистрСведений.ЗаписиКонтроляДоступа КАК ЗаписиКонтроляДоступа
	|ГДЕ
	|	ЗаписиКонтроляДоступа.ФизическоеЛицо = &ФизическоеЛицо
	|	И ЗаписиКонтроляДоступа.ДатаЗаписи МЕЖДУ &ДатаНачало И &ДатаОкончание
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаписиКонтроляДоступа.ДатаЗаписи";

	Запрос.УстановитьПараметр("ФизическоеЛицо", ФізичнаОсоба);
	Запрос.УстановитьПараметр("ДатаНачало",     НачалоДня(ДатаПочатку));
	Запрос.УстановитьПараметр("ДатаОкончание",  КонецДня(ДатаОкончания));

	Результат_Запроса = Запрос.Выполнить();

	// ── формування табличного документа ──────────────────────────
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяФайлаКлиентскогоПриложения = "КонтрольДоступу";

	// Макет — будуємо програмно (без зовнішнього макета)
	Стиль = ПолучитьМакетСтиля();

	// Заголовок
	Область = ТабДок.ПолучитьОбласть("R1");
	ТабДок.НачатьАвтогруппировкуСтрок();

	ВывестиЗаголовок(ТабДок, ФізичнаОсоба, ДатаПочатку, ДатаОкончания);
	ВывестиШапкуТаблицы(ТабДок);
	ВывестиСтроки(ТабДок, Результат_Запроса.Выгрузить());
	ВывестиИтог(ТабДок, Результат_Запроса.Количество());

	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ЗащитаПоставлена = Ложь;

	// Відображення у формі
	Результат = ТабДок;

КонецПроцедуры

// ─── допоміжні процедури виводу ─────────────────────────────────────────────

&НаСервері
Процедура ВывестиЗаголовок(ТабДок, Особа, ДатаН, ДатаК)

	// Рядок 1 — назва звіту
	ТабДок.ВысотаСтрок = 20;
	Яч = ТабДок.ПолучитьОбласть(1, 1, 1, 5);
	Яч.Область(1,1,1,5).Объединить();
	Яч.Область(1,1).Текст = "Записи контролю доступу";
	Яч.Область(1,1).ШрифтЖирный = Истина;
	Яч.Область(1,1).РазмерШрифта = 14;
	Яч.Область(1,1).ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	ТабДок.Вывести(Яч);

	// Рядок 2 — ПІБ + період
	Яч2 = ТабДок.ПолучитьОбласть(1, 1, 1, 5);
	Яч2.Область(1,1,1,5).Объединить();
	Яч2.Область(1,1).Текст = Строка(Особа) + "  |  "
		+ Формат(ДатаН, "ДФ=dd.MM.yyyy") + " — " + Формат(ДатаК, "ДФ=dd.MM.yyyy");
	Яч2.Область(1,1).ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	Яч2.Область(1,1).ЦветФона = ВебЦвета.AliceBlue;
	ТабДок.Вывести(Яч2);

	// Порожній рядок
	ТабДок.ВывестиГоризонтальныйРазделитель();

КонецПроцедуры

&НаСервері
Процедура ВывестиШапкуТаблицы(ТабДок)

	Шапки = Новый Массив;
	Шапки.Добавить(Новый Структура("Текст, Ширина", "№",                    5));
	Шапки.Добавить(Новый Структура("Текст, Ширина", "Дата і час",          20));
	Шапки.Добавить(Новый Структура("Текст, Ширина", "Тип дії",             12));
	Шапки.Добавить(Новый Структура("Текст, Ширина", "Контроль доступу",    25));
	Шапки.Добавить(Новый Структура("Текст, Ширина", "Номер запису",        15));

	Строка = ТабДок.ПолучитьОбласть(1, 1, 1, Шапки.Количество());

	Для Инд = 0 По Шапки.Количество() - 1 Цикл
		Яч = Строка.Область(1, Инд + 1);
		Яч.Текст                     = Шапки[Инд].Текст;
		Яч.ШрифтЖирный               = Истина;
		Яч.ГоризонтальноеПоложение   = ГоризонтальноеПоложениеЭлемента.Центр;
		Яч.ЦветФона                  = ВебЦвета.SteelBlue;
		Яч.ЦветТекста                = ВебЦвета.White;
		Яч.Рамка                     = Новый Рамка(ВидРамки.Сплошная, ЦветРамки.Авто);
		ТабДок.ШиринаКолонок(Инд + 1) = Шапки[Инд].Ширина;
	КонецЦикла;

	ТабДок.Вывести(Строка);

КонецПроцедуры

&НаСервері
Процедура ВывестиСтроки(ТабДок, ТаблицаДанных)

	Номер = 0;
	ЧередующийЦвет = Ложь;

	Для Каждого Стр Из ТаблицаДанных Цикл
		Номер = Номер + 1;

		ЦветФона = ?(ЧередующийЦвет, ВебЦвета.AliceBlue, ВебЦвета.White);
		ЧередующийЦвет = НЕ ЧередующийЦвет;

		// Колір рядка залежно від типу дії
		Если НРег(Строка(Стр.ТипДействия)) = "вхід" ИЛИ НРег(Строка(Стр.ТипДействия)) = "вход" Тогда
			ЦветТипу = ВебЦвета.DarkGreen;
		ИначеЕсли НРег(Строка(Стр.ТипДействия)) = "вихід" ИЛИ НРег(Строка(Стр.ТипДействия)) = "выход" Тогда
			ЦветТипу = ВебЦвета.Crimson;
		Иначе
			ЦветТипу = ВебЦвета.Black;
		КонецЕсли;

		Рег = ТабДок.ПолучитьОбласть(1, 1, 1, 5);

		Яч1 = Рег.Область(1, 1);
		Яч1.Текст = Номер;
		Яч1.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		Яч1.ЦветФона = ЦветФона;

		Яч2 = Рег.Область(1, 2);
		Яч2.Текст = Формат(Стр.ДатаЗаписи, "ДФ=dd.MM.yyyy HH:mm:ss");
		Яч2.ЦветФона = ЦветФона;

		Яч3 = Рег.Область(1, 3);
		Яч3.Текст = Стр.ТипДействия;
		Яч3.ЦветТекста = ЦветТипу;
		Яч3.ШрифтЖирный = Истина;
		Яч3.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		Яч3.ЦветФона = ЦветФона;

		Яч4 = Рег.Область(1, 4);
		Яч4.Текст = Стр.КонтрольДоступа;
		Яч4.ЦветФона = ЦветФона;

		Яч5 = Рег.Область(1, 5);
		Яч5.Текст = Стр.НомерЗаписи;
		Яч5.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		Яч5.ЦветФона = ЦветФона;

		// Рамки
		Для Кол = 1 По 5 Цикл
			Рег.Область(1, Кол).Рамка = Новый Рамка(ВидРамки.Сплошная, ВебЦвета.LightGray);
		КонецЦикла;

		ТабДок.Вывести(Рег);

	КонецЦикла;

КонецПроцедуры

&НаСервері
Процедура ВывестиИтог(ТабДок, КількістьЗаписів)

	ТабДок.ВывестиГоризонтальныйРазделитель();

	Рег = ТабДок.ПолучитьОбласть(1, 1, 1, 5);
	Рег.Область(1,1,1,5).Объединить();
	Рег.Область(1,1).Текст = "Усього записів: " + КількістьЗаписів;
	Рег.Область(1,1).ШрифтЖирный = Истина;
	Рег.Область(1,1).ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	Рег.Область(1,1).ЦветФона = ВебЦвета.AliceBlue;

	ТабДок.Вывести(Рег);

КонецПроцедуры

// ─── команди друку / збереження ─────────────────────────────────────────────

&НаКлиенте
Процедура НадрукуватиЗвіт(Команда)
	Результат.Напечатать(РежимИспользованияДиалога.СДиалогом);
КонецПроцедуры

&НаКлиенте
Процедура ЗберегтиВExcel(Команда)
	ДіалогЗбереження = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДіалогЗбереження.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|Всі файли (*.*)|*.*";
	ДіалогЗбереження.ПолноеИмяФайла = "КонтрольДоступу_"
		+ Формат(ДатаПочатку, "ДФ=yyyyMMdd") + "_" + Формат(ДатаОкончания, "ДФ=yyyyMMdd");
	Если ДіалогЗбереження.Выбрать() Тогда
		Результат.Записать(ДіалогЗбереження.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	КонецЕсли;
КонецПроцедуры
